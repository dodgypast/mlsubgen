# mlsubgen — copy to .env and edit. docker compose reads this file twice: for the ${...} values in compose.yaml
# and (env_file) as the containers' environment.

# Your videos. Bind-mounted at /media inside the containers; subtitles are written beside each video.
MEDIA_DIR=/path/to/your/videos
# The folders the worker may run jobs on and the web picker may browse — container paths, colon-separated.
MLSUBGEN_MEDIA_ROOTS=/media

# Default subtitle languages, comma-separated (`mlsubgen languages` lists the 45 codes); --target per job overrides.
MLSUBGEN_TARGETS=en

# The translator: Ollama on this host (host networking), or any OpenAI-compatible server (--backend openai).
MLSUBGEN_LLM_URL=http://127.0.0.1:11434

# The web UI port (no login — LAN or VPN only).
MLSUBGEN_WEB_PORT=8790

# The user the containers run as — your uid/gid, so the .srt files, /data and /models are owned by you (`id -u`, `id -g`).
PUID=1000
PGID=1000

# The Hugging Face cache (Qwen3-ASR, the aligner, whisper large-v3: ~8 GB after the first run).
MODELS_DIR=./models
# 1 = never contact huggingface.co (after the models are downloaded). 0 = allow downloads.
HF_HUB_OFFLINE=0
